@model List<Skill>
@{
    ViewData["Title"] = "Yetenekler";
    Layout = "~/Views/AdminLayout/Layout.cshtml";
}

<table class="table table-hover table-bordered" >
    <tr>
        <th>Yetenek</th>
        <th>Aktif</th>
        <th>İşlemler</th>
    </tr>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Name</td>
            <td>
                <input type="checkbox" @(item.IsActive ? "checked" : "") disabled />
            </td>
            <td>
                <button onclick="deleteSkill(@item.Id)" class="btn btn-outline-danger">Sil</button>
                <a href="/Skill/UpdateSkill/@item.Id" class="btn btn-outline-info">Güncelle</a>
            </td>
        </tr>
    }
</table>
<div class="mt-3">
    <a href="/Skill/CreateSkill" class="btn btn-outline-dark">
        Yeni Yetenek Ekle
    </a>
</div>

<script>
    function deleteSkill(id){
            Swal.fire({
      title: "Silmek İstediğinize Emin Misiniz?",
      text: "Bu İşlemi Geri Alamazsınız!",
      icon: "warning",
      showCancelButton: true,
      confirmButtonColor: "#3085d6",
      cancelButtonColor: "#d33",
      confirmButtonText: "Evet, Sil!",
      cancelButtonText: "İptal"
    }).then((result) => {
      if (result.isConfirmed)
      window.location.href = "/Skill/DeleteSkill/"+id;
    });
    }
</script>

