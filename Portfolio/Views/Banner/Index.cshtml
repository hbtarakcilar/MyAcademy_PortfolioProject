@model List<Banner>
@{
    ViewData["Title"] = "Banner";
    Layout = "~/Views/AdminLayout/Layout.cshtml";
}

<table class="table table-hover table-bordered">
    <tr>
        <th>Görsel URL</th>
        <th>Başlık</th>
        <th>Açıklama</th>
        <th>İşlemler</th>
    </tr>
    @foreach (var item in Model)
    {
        <tr>
            <td><img src="@item.ImageUrl" style="height:50px;width:50px;"/></td>
            <td>@item.Title</td>
            <td>@item.Description</td>
            <td>
                <button onclick="deleteBanner(@item.Id)" class="btn btn-outline-danger">Sil</button>
                <a href="/Banner/UpdateBanner/@item.Id" class="btn btn-outline-info">Güncelle</a>
            </td>
        </tr>
    }
</table>

<div class="mt-3">
    <a href="/Banner/CreateBanner" class="btn btn-outline-dark">
        Yeni Banner Ekle
    </a>
</div>

<script>
    function deleteBanner(id){
            Swal.fire({
      title: "Silmek İstediğinize Emin Misiniz?",
      text: "Bu İşlemi Geri Alamazsınız!",
      icon: "warning",
      showCancelButton: true,
      confirmButtonColor: "#3085d6",
      cancelButtonColor: "#d33",
      confirmButtonText: "Evet, Sil!",
      cancelButtonText: "İptal"
    }).then((result) => {
      if (result.isConfirmed)
      window.location.href = "/Banner/DeleteBanner/"+id;
    });
    }
</script>
