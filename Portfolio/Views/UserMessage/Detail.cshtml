@model UserMessage

@{
    ViewData["Title"] = "Mesaj Detayı";
    Layout = "~/Views/AdminLayout/Layout.cshtml";
}

<div class="card">
    <div class="card-header">
        <h4>Mesaj Detayı</h4>
    </div>

    <div class="card-body">
        <div class="mb-3">
            <label class="fw-bold">Ad Soyad</label>
            <p>@Model.Name</p>
        </div>

        <div class="mb-3">
            <label class="fw-bold">Email</label>
            <p>@Model.Email</p>
        </div>

        <div class="mb-3">
            <label class="fw-bold">Mesaj</label>
            <p>@Model.MessageBody</p>
        </div>

        <div class="mb-3">
            <label class="fw-bold">Durum</label>
            <p>
                @if (Model.IsRead)
                {
                    <span class="badge bg-success">Okundu</span>
                }
                else
                {
                    <span class="badge bg-warning text-dark">Okunmadı</span>
                }
            </p>
        </div>

        <a href="/UserMessage/Index" class="btn btn-outline-dark">Mesajlara Dön</a>
        <button onclick="deleteMessage(@Model.Id)" class="btn btn-outline-danger btn-sm">
            Sil
        </button>
    </div>
</div>

<script>
    function deleteMessage(id) {
        Swal.fire({
            title: "Mesajı silmek istediğinize emin misiniz?",
            text: "Bu işlemi geri alamazsınız!",
            icon: "warning",
            showCancelButton: true,
            confirmButtonColor: "#3085d6",
            cancelButtonColor: "#d33",
            confirmButtonText: "Evet, Sil",
            cancelButtonText: "İptal"
        }).then((result) => {
            if (result.isConfirmed) {
                window.location.href = "/UserMessage/Delete/" + id;
            }
        });
    }
</script>