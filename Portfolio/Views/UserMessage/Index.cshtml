@model List<UserMessage>

@{
    ViewData["Title"] = "Gelen Mesajlar";
    Layout = "~/Views/AdminLayout/Layout.cshtml";
}

<div class="mb-3">
    <a href="/UserMessage/Index" class="btn btn-outline-dark">Tüm Mesajlar</a>
    <a href="/UserMessage/ReadMessages" class="btn btn-outline-success">Okunanlar</a>
    <a href="/UserMessage/UnreadMessages" class="btn btn-outline-primary">Okunmayanlar</a>
</div>

<table class="table table-bordered table-hover">
    <tr>
        <th>Ad Soyad</th>
        <th>Email</th>
        <th>Mesaj Önizlemesi</th>
        <th>Durum</th>
        <th>İşlemler</th>
    </tr>

    @foreach (var item in Model)
    {
        string rowClass;

        if (item.IsRead == true)
        {
            rowClass = "table-light";
        }
        else
        {
            rowClass = "table-info";
        }

        <tr class="@rowClass">
            <td>@item.Name</td>
            <td>@item.Email</td>
            <td>
                @if (item.MessageBody.Length > 60)
                {
                    @item.MessageBody.Substring(0, 60)
                    <span>...</span>
                }
                else
                {
                    @item.MessageBody
                }
            </td>
            <td>
                @if (item.IsRead)
                {
                    <span class="badge bg-success">Okundu</span>
                }
                else
                {
                    <span class="badge bg-secondary">Okunmadı</span>
                }
            </td>
            <td>
                <a href="/UserMessage/Detail/@item.Id" class="btn btn-outline-info btn-sm">Detay</a>
                <button onclick="deleteMessage(@item.Id)" class="btn btn-outline-danger btn-sm">
                    Sil
                </button>
            </td>
        </tr>
    }
</table>

<script>
    function deleteMessage(id) {
        Swal.fire({
            title: "Mesajı silmek istediğinize emin misiniz?",
            text: "Bu işlemi geri alamazsınız!",
            icon: "warning",
            showCancelButton: true,
            confirmButtonColor: "#3085d6",
            cancelButtonColor: "#d33",
            confirmButtonText: "Evet, Sil",
            cancelButtonText: "İptal"
        }).then((result) => {
            if (result.isConfirmed) {
                window.location.href = "/UserMessage/Delete/" + id;
            }
        });
    }
</script>