@model List<ProjectTechStack>

@{
    ViewData["Title"] = "Teknolojileri Yönet";
    Layout = "~/Views/AdminLayout/Layout.cshtml";
}

<h3>Proje: @Model.First().Project.Name</h3>

<table class="table table-bordered table-hover">
    <tr>
        <th>Teknoloji</th>
        <th>İşlem</th>
    </tr>

    @foreach (var item in Model)
    {
        <tr>
            <td>@item.TechStack.Name</td>
            <td>
                <button onclick="deleteTech(@item.Id)" class="btn btn-danger btn-sm">
                    Sil
                </button>
            </td>
        </tr>
    }
</table>


<a href="/ProjectTechStacks/Create" class="btn btn-success">
    Yeni Teknoloji Ekle
</a>

<script>
    function deleteTech(id) {
        Swal.fire({
            title: "Silmek İstediğinize Emin Misiniz?",
            text: "Bu işlemi geri alamazsınız!",
            icon: "warning",
            showCancelButton: true,
            confirmButtonColor: "#3085d6",
            cancelButtonColor: "#d33",
            confirmButtonText: "Evet, Sil!",
            cancelButtonText: "İptal"
        }).then((result) => {
            if (result.isConfirmed) {
                window.location.href = "/ProjectTechStacks/Delete/" + id;
            }
        });
    }
</script>